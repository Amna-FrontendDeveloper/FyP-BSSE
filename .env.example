# Never commit a real .env file. Generate separate secrets for each environment.
APP_ENV=development
SECRET_KEY=replace-with-a-random-32-byte-or-longer-secret
DATABASE_PATH=database/app.db
LOG_LEVEL=INFO
ADMIN_EMAILS=your.email@example.com
AI_API_KEY=replace-with-your-ai-provider-key
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
APP_ENCRYPTION_KEY=replace-with-a-fernet-key
